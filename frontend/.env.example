# Optional defaults for the frontend. Every value can also be set at runtime in
# the in-app Settings panel (stored in the browser), so a deployed UI keeps
# working even if these are empty.

# URL of the ClipForge engine. If unset, the UI defaults to http://127.0.0.1:8000
# (works when the UI and engine run on the same machine). For a Vercel deploy,
# set this to your tunnel/VM URL, or just let users enter it in Settings.
# NEXT_PUBLIC_API_BASE=https://your-engine.example.com

# Shared secret, only needed if the engine was started with
# CLIPFORGE_ACCESS_TOKEN set. Users can also enter it in Settings.
# NEXT_PUBLIC_ACCESS_TOKEN=
