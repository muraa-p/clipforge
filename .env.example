# Copy to .env and edit. Used by docker-compose.yml.

# Shared secret the UI must send. Strongly recommended when the engine is public.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
CLIPFORGE_ACCESS_TOKEN=

# Host port to expose the engine on.
CLIPFORGE_PORT=8000

# Public-safety limits.
CLIPFORGE_MAX_CONCURRENT_JOBS=2
CLIPFORGE_MAX_QUEUED_JOBS=8
CLIPFORGE_DATA_TTL_HOURS=24

# Optional AI (bring your own free key). Leave blank for offline heuristics.
# One of: groq | cerebras | gemini | mistral | openrouter | ollama | opencode | custom
CLIPFORGE_LLM_PROVIDER=
CLIPFORGE_LLM_API_KEY=
# CLIPFORGE_LLM_MODEL=
# CLIPFORGE_LLM_BASE_URL=
